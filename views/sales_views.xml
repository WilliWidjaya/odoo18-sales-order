<odoo>
    <data>
        
        <record id="sales_order_view_list" model="ir.ui.view">
            <field name="name">sales.order.view.list</field>
            <field name="model">sales_order</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="contact_person"/>
                </list>
            </field>
        </record>
        
        <record id = "sales_form" model = "ir.ui.view">
            <field name="name">sales.form</field>
            <field name="model">sales_order</field>
            <field name="arch" type="xml">
                <form string = "Sales Order Form">
                    <group class = "sl-format-grid">
                        <sheet>
                            <group class = "sl-format-grid">
                                <group class = "sl-format-bg">

                                    <!-- SALES ID -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales ID</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_id" placeholder = "e.g. CUS-158232"/>
                                    </div>

                                    <!-- CUSTOMER ID -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Customer ID</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="customer_id" placeholder = "e.g. cID-001"/>
                                    </div>

                                    <!-- Contact Person -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Contact Person</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="contact_person"/>
                                    </div>

                                    <!-- Customer Reference Number -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Customer Ref. No</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="customer_ref_no" placeholder = "e.g. 00122323"/>
                                    </div>

                                    <!-- Currency -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Currency</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="currency" placeholder = "e.g. Rp. $"/>
                                    </div>

                                </group>
                                <group class = "sl-format-bg">

                                    <!-- Sales Order Number -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales Order Number</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_order_number" placeholder = "enter sales order num.."/>
                                    </div>

                                    <!-- Sales Order Status -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales Order Status</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_order_status" placeholder = "enter status.."/>
                                    </div>

                                    <!-- Posting Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Posting Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="posting_date"/>
                                    </div>

                                    <!-- Delivery Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Delivery Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="delivery_date"/>
                                    </div>

                                    <!-- Document Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Document Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="document_date"/>
                                    </div>

                                </group>
                            </group>
                            
                            
                            <notebook>
                                <page string = "Contents">
                                    <group class = "sl-contents-header">
                                        <div class = "sl-contents-header-item">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Item/Service Type</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "item_or_service_type" name="document_date"/>
                                            </div>
                                        </div>
                                        <div class = "sl-contents-header-item">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Document Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="document_date"/>
                                            </div>
                                        </div>
                                    </group>
                                    <div class = "sl-contents-horizontal-line"></div>
                                    <field name = "sales_contents"/>
                                </page>
                                
                                <page string = "Logistics">
                                    <group class = "sl-logistics-format">
                                        
                                        <group class = "sl-logistics-left">
                                            <group class = "sl-logistics-group">
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override">Shipping Location</div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "summary_type" name="shipping_location"/>
                                                    </div>
                                                </group>
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override"></div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "sl-textbox" name="ship_ta" string = "" />
                                                    </div>
                                                </group>
                                            </group>
                                            
                                            <group class = "sl-logistics-group">
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override">Pay To</div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "summary_type" name="payment_info"/>
                                                    </div>
                                                </group>
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override"></div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "sl-textbox" name="pay_ta" string = ""/>
                                                    </div>
                                                </group>
                                            </group>
                                        </group>
                                        
                                        <group class = "sl-logistics-right">
                                            <field name = "summary_type"/>
                                        </group>
                                        
                                    </group>
                                </page>
                                
                                <page string = "Accounting">
                                    <group class = "sl-accounting-format">
                                        
                                        <group class = "sl-accounting-format-bg">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Order Number</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="order_number"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Journal Remarks</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="journal_remark"/>
                                            </div>
                                        </group>


                                        <group class = "sl-accounting-format-bg">

                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Payment Term</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="payment_term"/>
                                            </div>

                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Payment Method</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="payment_method"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">BP Project </div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="bp_project"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Indicator</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="indicator"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Tax ID</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="tax_id"/>
                                            </div>
                                            
                                            
                                        </group>

                                        <group class = "sl-accounting-format-bg">
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Due Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="due_date"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Cancellation Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="cancellation_date"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Required Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="required_date"/>
                                            </div>
                                            
                                            
                                        </group>
                                    </group>
                                </page>
                            </notebook>

                        </sheet>

                    </group>
                </form>
            </field>
        </record>
        
        <record id="sales_order_content_view_list" model="ir.ui.view">
            <field name="name">sales.order.content.viewlist</field>
            <field name="model">sales_content</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <field name="item_no"/>
                    <field name="item_desc"/>
                    <field name="quantity"/>
                    <field name="uom_code"/>
                    <field name="unit_price"/>
                    <field name="discount_percentage"/>
                    <field name="tax_code"/>
                </list>
            </field>
        </record>
        
        <record id="sales_order_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Order</field>
            <field name="res_model">sales_order</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>
