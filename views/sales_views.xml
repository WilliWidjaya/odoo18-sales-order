<odoo>
    <data>
        
        <!-- SALES ORDER MAIN ACTION -->
        <record id="sales_order_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Order</field>
            <field name="res_model">sales_order</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- SALES ITEM ACTION -->
        <record id="sales_item_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Item</field>
            <field name="res_model">sales_item</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- SALES CONTACT ACTION -->
        <record id="sales_contact_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Contact</field>
            <field name="res_model">sales_contact</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- SALES CUSTOMER ACTION -->
        <record id="sales_customer_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Customer</field>
            <field name="res_model">sales_customer</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- SALES PAYMENT INFO ACTION -->
        <record id="sales_payment_info_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Payment Info</field>
            <field name="res_model">payment_info</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- SALES SALES LOCATION ACTION -->
        <record id="sales_ship_location_action" model="ir.actions.act_window">
            <field name="name">Halaman Sales Location</field>
            <field name="res_model">ship_location</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="sales_order_view_list" model="ir.ui.view">
            <field name="name">sales.order.view.list</field>
            <field name="model">sales_order</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="contact_person"/>
                </list>
            </field>
        </record>
        
        <!-- LIST DAN FORM CONTACT -->
        <record id="sales_contact_view_list" model="ir.ui.view">
            <field name="name">sales.contact.view.list</field>
            <field name="model">sales_contact</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <control>
                        <create name="custom_line" string="Add a new contact.."/>
                    </control>
                    <field name="name"/>
                    <field name="location"/>
                </list>
            </field>
        </record>
        
        <record id="sales_contact_form" model="ir.ui.view">
            <field name="name">sales.contact.form</field>
            <field name="model">sales_contact</field>
            <field name="arch" type="xml">
                <form string="Request Form">
                    <header class = "req-header-pad">
                         <button class = "po-header-button btn-primary oi oi-chevron-left" type = "action" string = "Back" name ="%(sales_order.sales_contact_action)d"/>
                         </header>
                    <group class = "item-format-grid">
                        <sheet class = "item-format-sheet">
                            <group class = "item-format-sheet-group">
                                <div class = "item-group-title"><h3>Informasi Contact</h3></div>
                                <group class = "item-field-group">
                                    <field name ="name"/>
                                    <field name ="location"/>
                                </group>
                            </group>
                        </sheet>
                    </group>
                </form>
            </field>
        </record>
        
        <!-- LIST AND FORM CUSTOMER -->
        <record id="sales_customer_view_list" model="ir.ui.view">
            <field name="name">sales.customer.view.list</field>
            <field name="model">sales_customer</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <control>
                        <create name="custom_line" string="Add a new customer.."/>
                    </control>
                    <field name="name"/>
                    <field name="customer_information"/>
                </list>
            </field>
        </record>
        
        <record id="sales_customer_form" model="ir.ui.view">
            <field name="name">sales.customer.form</field>
            <field name="model">sales_customer</field>
            <field name="arch" type="xml">
                <form string="Request Form">
                    <header class = "req-header-pad">
                         <button class = "po-header-button btn-primary oi oi-chevron-left" type = "action" string = "Back" name ="%(sales_order.sales_customer_action)d"/>
                         </header>
                    <group class = "item-format-grid">
                        <sheet class = "item-format-sheet">
                            <group class = "item-format-sheet-group">
                                <div class = "item-group-title"><h3>Informasi Customer</h3></div>
                                <group class = "item-field-group">
                                    <field name ="name"/>
                                    <field name ="customer_information"/>
                                </group>
                            </group>
                        </sheet>
                    </group>
                </form>
            </field>
        </record>
        
        <!-- LIST DAN FORM LOCATION -->
        <record id="sales_ship_location_view_list" model="ir.ui.view">
            <field name="name">sales.ship.location.view.list</field>
            <field name="model">ship_location</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <control>
                        <create name="custom_line" string="Add a new shipping location.."/>
                    </control>
                    <field name="shipping_location"/>
                </list>
            </field>
        </record>
        
        <record id="sales_ship_location_form" model="ir.ui.view">
            <field name="name">sales.ship.location.form</field>
            <field name="model">ship_location</field>
            <field name="arch" type="xml">
                <form string="Request Form">
                    <header class = "req-header-pad">
                         <button class = "po-header-button btn-primary oi oi-chevron-left" type = "action" string = "Back" name ="%(sales_order.sales_ship_location_action)d"/>
                         </header>
                    <group class = "item-format-grid">
                        <sheet class = "item-format-sheet">
                            <group class = "item-format-sheet-group">
                                <div class = "item-group-title"><h3>Lokasi/Tujuan Shipping</h3></div>
                                <group class = "item-field-group">
                                    <field name ="shipping_location"/>
                                </group>
                            </group>
                        </sheet>
                    </group>
                </form>
            </field>
        </record>
        
        <!-- LIST DAN FORM PAYMENT INFORMATION -->
        <record id="sales_payment_info_view_list" model="ir.ui.view">
            <field name="name">sales.payment.info.view.list</field>
            <field name="model">payment_info</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <control>
                        <create name="custom_line" string="Add a new payment information.."/>
                    </control>
                    <field name = "name"/>
                    <field name="payment_details"/>
                </list>
            </field>
        </record>
        
        <record id="sales_payment_information_form" model="ir.ui.view">
            <field name="name">sales.payment.information.form</field>
            <field name="model">payment_info</field>
            <field name="arch" type="xml">
                <form string="Request Form">
                    <header class = "req-header-pad">
                         <button class = "po-header-button btn-primary oi oi-chevron-left" type = "action" string = "Back" name ="%(sales_order.sales_payment_info_action)d"/>
                    </header>
                    <group class = "item-format-grid">
                        <sheet class = "item-format-sheet">
                            <group class = "item-format-sheet-group">
                                <div class = "item-group-title"><h3>Informasi Pembayaran</h3></div>
                                <group class = "item-field-group">
                                    <field name ="name"/>
                                    <field name ="payment_details"/>    
                                </group>
                            </group>
                        </sheet>
                    </group>
                </form>
            </field>
        </record>
        
        
        <!-- LIST DAN FORM ITEM -->
        <record id="sales_item_view_list" model="ir.ui.view">
            <field name="name">sales.item.view.list</field>
            <field name="model">sales_item</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <control>
                        <create name="custom_line" string="Add a new Item.."/>
                    </control>
                    <field name="item_code"/>
                    <field name="item_desc"/>
                </list>
            </field>
        </record>
        
        <record id="sales_item_form" model="ir.ui.view">
            <field name="name">sales.item.form</field>
            <field name="model">sales_item</field>
            <field name="arch" type="xml">
                <form string="Request Form">
                    <header class = "req-header-pad">
                        <button class = "po-header-button btn-primary oi oi-chevron-left" type = "action" string = "Back" name ="%(sales_order.sales_item_action)d"/>
                    </header>
                    <group class = "item-format-grid">
                        <sheet class = "item-format-sheet">
                            <group class = "item-format-sheet-group">
                                <div class = "item-group-title"><h3>Informasi Item</h3></div>
                                <group class = "item-field-group">
                                    <field name ="item_code"/>
                                    <field name ="item_desc"/>
                                    <field name ="item_uom"/>
                                    <field name ="item_tax_code"/>
                                </group>
                            </group>
                        </sheet>
                    </group>
                </form>
            </field>
        </record>
        
        <!-- SALES CONTENT FORM -->
        <record id="sales_content_view_list" model="ir.ui.view">
            <field name="name">sales.content.view.list</field>
            <field name="model">sales_content</field>
            <field name="arch" type="xml">
                <list string = "Channel" editable = "bottom">
                    <control>
                        <create name="custom_line" string="Add a new Item.."/>
                    </control>
                    <field name="item_id"/>
                    <field name="item_desc"/>
                    <field name="quantity"/>
                    <field name="uom_code"/>
                    <field name="unit_price"/>
                    <field name="tax_code"/>
                </list>
            </field>
        </record>
        

        <record id = "sales_form" model = "ir.ui.view">
            <field name="name">sales.form</field>
            <field name="model">sales_order</field>
            <field name="arch" type="xml">
                <form string = "Sales Order Form">
                    <group class = "sl-format-grid">
                        <sheet>
                            <group class = "sl-format-grid">
                                <group class = "sl-format-bg">

                                    <!-- SALES ID -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales ID</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_id" placeholder = "e.g. CUS-158232"/>
                                    </div>

                                    <!-- CUSTOMER ID -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Customer ID</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="customer_id" placeholder = "e.g. cID-001"/>
                                    </div>

                                    <!-- Contact Person -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Contact Person</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="contact_person" placeholder = "Select a contact.."/>
                                    </div>

                                    <!-- Customer Reference Number -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Customer Ref. No</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="customer_ref_no" placeholder = "e.g. 00122323"/>
                                    </div>

                                    <!-- Currency -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Currency</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="currency" placeholder = "e.g. Rp. $"/>
                                    </div>

                                </group>
                                <group class = "sl-format-bg">

                                    <!-- Sales Order Number -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales Order Number</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_order_number" placeholder = "enter sales order num.."/>
                                    </div>

                                    <!-- Sales Order Status -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Sales Order Status</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="sales_order_status" placeholder = "enter status.."/>
                                    </div>

                                    <!-- Posting Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Posting Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="posting_date" placeholder = "select posting date.."/>
                                    </div>

                                    <!-- Delivery Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Delivery Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="delivery_date" placeholder = "select delivery date.."/>
                                    </div>

                                    <!-- Document Date -->
                                    <span class = "o_form_label o_td_label">
                                        <div class = "o_form_label_override">Document Date</div>
                                    </span>
                                    <div class = "input-box-parent-div">
                                        <field class = "input-box" name="document_date" placeholder = "select document date.."/>
                                    </div>

                                </group>
                            </group>
                            
                            
                            <notebook>
                                <page string = "Contents">
                                    <group class = "sl-contents-header">
                                        <div class = "sl-contents-header-item">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Item/Service Type</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "item_or_service_type" name="item_or_service_type"/>
                                            </div>
                                        </div>
                                        <div class = "sl-contents-header-item">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Document Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="document_date"/>
                                            </div>
                                        </div>
                                    </group>
                                    <div class = "sl-contents-horizontal-line"></div>
                                    <field name = "sales_contents"/>
                                </page>
                                
                                <page string = "Logistics">
                                    <group class = "sl-logistics-format">
                                        
                                        <group class = "sl-logistics-left">
                                            <group class = "sl-logistics-group">
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override">Shipping Location</div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "summary_type" name="shipping_location" placeholder = "select shipping location.."/>
                                                    </div>
                                                </group>
                                                <group class = "sl-in-parent">
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override"></div>
                                                    </span>
                                                    <div class = "sl-in">
                                                        <field class = "sl-textbox" name="ship_ta" string = "" />
                                                    </div>
                                                </group>
                                            </group>
                                            
                                            <group class = "sl-logistics-group">
                                                <group>
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override">Pay To</div>
                                                    </span>
                                                    <div class = "input-box-parent-div">
                                                        <field class = "summary_type" name="payment_info" placeholder = "select payment procedure.."/>
                                                    </div>
                                                </group>
                                                <group class = "sl-in-parent">
                                                    <span class = "o_form_label o_td_label">
                                                        <div class = "o_form_label_override"></div>
                                                    </span>
                                                    <div class = "sl-in">
                                                        <field class = "sl-textbox" name="pay_ta" string = ""/>
                                                    </div>
                                                </group>
                                            </group>
                                        </group>
                                        
                                        <group class = "sl-logistics-right">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Shipping Type</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="shipping_type"/>
                                            </div>
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">BP Channel Name</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="bp_channel_name"/>
                                            </div>
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">BP Channel Contact</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="bp_channel_contact"/>
                                            </div>
                                        </group>
                                        
                                    </group>
                                </page>
                                
                                <page string = "Accounting">
                                    <group class = "sl-accounting-format">
                                        
                                        <group class = "sl-accounting-format-bg">
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Order Number</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="order_number"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Journal Remarks</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="journal_remark"/>
                                            </div>
                                        </group>


                                        <group class = "sl-accounting-format-bg">

                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Payment Term</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="payment_term"/>
                                            </div>

                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Payment Method</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="payment_method"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">BP Project </div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="bp_project"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Indicator</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="indicator"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Tax ID</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="tax_id"/>
                                            </div>
                                            
                                            
                                        </group>

                                        <group class = "sl-accounting-format-bg">
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Due Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="due_date"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Cancellation Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="cancellation_date"/>
                                            </div>
                                            
                                            <span class = "o_form_label o_td_label">
                                                <div class = "o_form_label_override">Required Date</div>
                                            </span>
                                            <div class = "input-box-parent-div">
                                                <field class = "summary_type" name="required_date"/>
                                            </div>
                                            
                                            
                                        </group>
                                    </group>
                                </page>
                                <page string = "Attachments">
                                    <field name ="att_attachment"/>
                                </page>
                            </notebook>

                        </sheet>

                    </group>
                </form>
            </field>
        </record>
        
        <record id="sales_order_content_view_list" model="ir.ui.view">
            <field name="name">sales.order.content.viewlist</field>
            <field name="model">sales_content</field>
            <field name="arch" type="xml">
                <list string = "Channel">
                    <field name="item_id"/>
                    <field name="item_desc"/>
                    <field name="quantity"/>
                    <field name="uom_code"/>
                    <field name="unit_price"/>
                    <field name="discount_percentage"/>
                    <field name="tax_code"/>
                </list>
            </field>
        </record>
        
    </data>
</odoo>
